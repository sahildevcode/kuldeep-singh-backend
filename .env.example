# ==============================================================================
# Kuldeep Singh Studio - Backend Environment Configuration (.env.example)
# ==============================================================================
# NOTE: Copy this file to .env and fill in the actual secret values.
# NEVER commit your actual .env file or production secrets to Git.

# Server Port (Default: 5000)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xr4tur3.mongodb.net/kuldeep_studio?retryWrites=true&w=majority
MONGODB_URI=

# Session / JWT Encryption Secret (Must be a long random 64+ char secret string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Resend Email API Key (for transactional Admin 2FA OTP & alerts)
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=
# Verified Sending Address (e.g. "Kuldeep Singh Atelier <security@kuldeepsingh.art>" or "Kuldeep Studio <onboarding@resend.dev>")
RESEND_FROM_EMAIL=onboarding@resend.dev

# Initial Authorized Administrator Email(s) - Comma-separated
# Only accounts with these emails can request admin OTP or access admin APIs
ADMIN_EMAILS=admin@kuldeepsingh.art,kuldeep@art.com

# Allowed CORS Origins (Comma-separated)
# Include your production customer frontend, production admin panel, and local dev ports
# Example: https://artistkuldeepsingh.com,https://artist-kuldeep-singh.vercel.app,https://kuldeep-singh-admin.vercel.app,http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=https://artistkuldeepsingh.com,https://artist-kuldeep-singh.vercel.app,https://kuldeep-singh-admin.vercel.app,http://localhost:5173,http://localhost:3000

# Razorpay Payment Gateway Credentials (Optional / Payment Processing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Bunny CDN / Stream Credentials (Optional / Video Hosting)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
